# Shared
NODE_ENV=development
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_API_URL=/
BACKEND_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=
SUPABASE_DB_PROJECT_REF=your_project_ref
SUPABASE_DB_PASSWORD=your_supabase_db_password
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
REDIS_URL=redis://localhost:6379/0
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret
GOOGLE_OAUTH_ENABLED=true
AI_SERVICE_URL=http://localhost:8100
DEFAULT_TIMEZONE=Africa/Lagos

# AI Services
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8100
OPENAI_API_KEY=your_openai_key
LANGCHAIN_TRACING_V2=false
PINECONE_API_KEY=your_pinecone_key
PINECONE_ENVIRONMENT=us-east-1-aws
TIKTOKEN_CACHE_DIR=/tmp/tiktoken

# Storage (S3 and Cloudflare R2 via S3 API)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=xcr8-assets
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=your_access_key
STORAGE_SECRET_ACCESS_KEY=your_secret_access_key
STORAGE_ENDPOINT_URL=

# Worker
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
